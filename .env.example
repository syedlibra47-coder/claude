# Copy to .env and fill in. Everything is optional: with nothing set the app
# runs in dry-run mode (messages are simulated, scoring is rule-based).

# --- AI (Claude) : lead analysis + personalised message drafts ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v23.0
# Any string you choose; paste the same value in Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
# App secret from Meta; when set, inbound webhooks must carry a valid signature.
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LANG=en

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- App ---
# Protects the dashboard with a browser login (user: admin). Set this before
# exposing the app beyond your own machine.
APP_PASSWORD=
DEFAULT_COUNTRY_CODE=971
# Hours offset from UTC used for quiet hours (Dubai = 4).
TZ_OFFSET_HOURS=4
DB_PATH=data/leads.db

# Optional: store leads in Postgres (e.g. Supabase) instead of the local SQLite
# file, so they survive restarts on hosts with temporary disks. See README.
# Use a password with letters and numbers only, or URL-encode special characters.
DATABASE_URL=
